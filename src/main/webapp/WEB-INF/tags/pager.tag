<%@ tag pageEncoding="UTF-8" %><%@ attribute name="result" required="true" type="org.springframework.data.domain.Page" %><%@ attribute name="path" required="true" %><%@ attribute name="q" required="true" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<div class="pagination"><span class="muted"><c:out value="${result.totalElements}"/> kết quả · Trang ${result.totalPages == 0 ? 0 : result.number+1}/${result.totalPages}</span><div class="page-links">
<c:if test="${result.number > 0}"><c:url var="previous" value="${path}"><c:param name="q" value="${q}"/><c:param name="page" value="${result.number-1}"/><c:param name="size" value="${result.size}"/></c:url><a class="page-btn" href="<c:out value='${previous}'/>">← Trước</a></c:if>
<c:if test="${result.totalPages > 0}"><c:forEach var="i" begin="${result.number > 2 ? result.number-2 : 0}" end="${result.number+2 < result.totalPages ? result.number+2 : result.totalPages-1}"><c:url var="pageUrl" value="${path}"><c:param name="q" value="${q}"/><c:param name="page" value="${i}"/><c:param name="size" value="${result.size}"/></c:url><a class="page-btn ${i == result.number ? 'active' : ''}" href="<c:out value='${pageUrl}'/>" aria-label="Trang ${i+1}">${i+1}</a></c:forEach></c:if>
<c:if test="${result.hasNext()}"><c:url var="next" value="${path}"><c:param name="q" value="${q}"/><c:param name="page" value="${result.number+1}"/><c:param name="size" value="${result.size}"/></c:url><a class="page-btn" href="<c:out value='${next}'/>">Sau →</a></c:if></div></div>
