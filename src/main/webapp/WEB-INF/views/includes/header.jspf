<%@ page pageEncoding="UTF-8" %>
<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><c:out value="${pageTitle}"/> · Catalog Admin</title>
<link rel="stylesheet" href="<c:url value='/css/app.css'/>"></head><body>
<header class="topbar"><a class="brand" href="<c:url value='/home'/>"><span class="brand-icon">C</span>Catalog<span class="brand-light">Admin</span></a>
<nav><a href="<c:url value='/home'/>">Trang chủ</a>
<c:if test="${pageContext.request.isUserInRole('ADMIN')}"><a href="<c:url value='/admin'/>">Tổng quan</a><a href="<c:url value='/admin/categories'/>">Category</a><a href="<c:url value='/admin/users'/>">User</a></c:if>
<c:choose><c:when test="${not empty pageContext.request.userPrincipal}"><span class="identity"><c:out value="${pageContext.request.userPrincipal.name}"/></span>
<form class="inline" method="post" action="<c:url value='/logout'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn small ghost">Đăng xuất</button></form>
</c:when><c:otherwise><a href="<c:url value='/login'/>">Đăng nhập</a><a href="<c:url value='/register'/>">Đăng ký</a></c:otherwise></c:choose></nav></header>
<main class="container">
<c:if test="${not empty success}"><div class="alert success" role="status"><c:out value="${success}"/></div></c:if>
<c:if test="${not empty error}"><div class="alert danger" role="alert"><c:out value="${error}"/></div></c:if>
