<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../includes/tags.jspf" %><c:set var="pageTitle" value="Quản lý Category"/><%@ include file="../../includes/header.jspf" %>
<section class="page-heading"><div><div class="eyebrow">QUẢN TRỊ / CATEGORY</div><h1>Quản lý Category</h1><p class="muted">Danh sách danh mục trong hệ thống.</p></div><a class="btn primary" href="<c:url value='/admin/categories/new'/>">+ Thêm danh mục</a></section>
<section class="card data-card"><form class="toolbar" method="get" action="<c:url value='/admin/categories'/>"><label class="sr-only" for="q">Tìm kiếm</label><input id="q" name="q" value="<c:out value='${q}'/>" placeholder="Tên hoặc mô tả danh mục" maxlength="100"><label for="size">Số dòng</label><select id="size" name="size"><c:forEach var="n" items="${[5,10,20]}"><option value="${n}" ${result.size == n ? 'selected' : ''}>${n}</option></c:forEach></select><button class="btn primary">Tìm kiếm</button><a class="btn secondary" href="<c:url value='/admin/categories'/>">Đặt lại</a></form>
<div class="table-wrap"><table><thead><tr><th>ID</th><th>Danh mục</th><th>Mô tả</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="row" items="${result.content}"><tr><td>#${row.id}</td><td class="strong"><c:out value="${row.name}"/></td><td class="description"><c:out value="${row.description}"/></td>
<td><span class="badge ${row.enabled ? 'green' : 'neutral'}">${row.enabled ? 'Hoạt động' : 'Đã khóa'}</span></td><td><div class="actions compact"><a class="btn small secondary" href="<c:url value='/admin/categories/${row.id}/edit'/>">Sửa</a>
<form method="post" action="<c:url value='/admin/categories/${row.id}/delete'/>" onsubmit="return confirm('Bạn có chắc muốn xóa danh mục này?');"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="q" value="<c:out value='${q}'/>"><input type="hidden" name="page" value="${result.number}"><input type="hidden" name="size" value="${result.size}"><button class="btn small danger">Xóa</button></form></div></td></tr></c:forEach>
<c:if test="${empty result.content}"><tr><td colspan="5" class="empty">Không có kết quả phù hợp. Thử từ khóa khác hoặc thêm danh mục mới.</td></tr></c:if></tbody></table></div>
<ui:pager result="${result}" path="/admin/categories" q="${q}"/></section>
<%@ include file="../../includes/footer.jspf" %>
