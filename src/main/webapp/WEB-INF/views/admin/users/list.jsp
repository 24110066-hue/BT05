<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../includes/tags.jspf" %><c:set var="pageTitle" value="Quản lý User"/><%@ include file="../../includes/header.jspf" %>
<section class="page-heading"><div><div class="eyebrow">QUẢN TRỊ / USER</div><h1>Quản lý User</h1><p class="muted">Danh sách tài khoản trong hệ thống.</p></div><a class="btn primary" href="<c:url value='/admin/users/new'/>">+ Thêm tài khoản</a></section>
<section class="card data-card"><form class="toolbar" method="get" action="<c:url value='/admin/users'/>"><label class="sr-only" for="q">Tìm kiếm</label><input id="q" name="q" value="<c:out value='${q}'/>" placeholder="Tên đăng nhập, họ tên hoặc email" maxlength="100"><label for="size">Số dòng</label><select id="size" name="size"><c:forEach var="n" items="${[5,10,20]}"><option value="${n}" ${result.size == n ? 'selected' : ''}>${n}</option></c:forEach></select><button class="btn primary">Tìm kiếm</button><a class="btn secondary" href="<c:url value='/admin/users'/>">Đặt lại</a></form>
<div class="table-wrap"><table><thead><tr><th>ID</th><th>Tài khoản</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="row" items="${result.content}"><tr><td>#${row.id}</td><td><div class="strong"><c:out value="${row.username}"/></div><small><c:out value="${row.fullName}"/></small></td><td><c:out value="${row.email}"/></td><td><span class="badge ${row.role == 'ADMIN' ? 'purple' : 'neutral'}"><c:out value="${row.role}"/></span></td>
<td><span class="badge ${row.enabled ? 'green' : 'neutral'}">${row.enabled ? 'Hoạt động' : 'Đã khóa'}</span></td><td><div class="actions compact"><a class="btn small secondary" href="<c:url value='/admin/users/${row.id}/edit'/>">Sửa</a>
<form method="post" action="<c:url value='/admin/users/${row.id}/delete'/>" onsubmit="return confirm('Bạn có chắc muốn xóa tài khoản này?');"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="q" value="<c:out value='${q}'/>"><input type="hidden" name="page" value="${result.number}"><input type="hidden" name="size" value="${result.size}"><button class="btn small danger">Xóa</button></form></div></td></tr></c:forEach>
<c:if test="${empty result.content}"><tr><td colspan="6" class="empty">Không có kết quả phù hợp. Thử từ khóa khác hoặc thêm tài khoản mới.</td></tr></c:if></tbody></table></div>
<ui:pager result="${result}" path="/admin/users" q="${q}"/></section>
<%@ include file="../../includes/footer.jspf" %>
